{
  "$schema": "https://opencode.aopencode-go/gpt-5.6-lunai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "allow",
      "git commit *": "deny",
      "git push *": "deny",
      "git clean *": "deny",
      "git reset *": "ask",
      "grep *": "allow",
      "rm -rf *": "deny",
      "dotnet ef database drop*": "deny",
      "npm publish*": "deny",
      "dotnet nuget push*": "deny",
      "docker * down*": "ask",
      "mongo*": "ask",
      "dotnet format *": "allow"
    },
    "edit": {
      "docs/CODING_STANDARDS.md": "ask",
      "docs/adr/**": "ask",
      "docs/GLOSSARY.md": "ask",
      "AGENTS.md": "ask"
    }
  },
  "agent": {
    "build": {
      "permission": {
        "bash": {
          "*": "ask",
          "git *": "allow",
          "git commit *": "ask",
          "git push *": "deny",
          "grep *": "allow"
        }
      }
    }
  },
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}