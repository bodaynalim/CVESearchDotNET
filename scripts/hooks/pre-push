#!/bin/sh
# pre-push hook (tickets T09 + T13): the preflight must pass before any push,
# regardless of whether a human or an agent pushes. Nothing lands on the remote
# that did not pass build/tests/doc-links locally. Editorconfig runs at
# pre-commit (faster feedback, see scripts/hooks/pre-commit), so it is skipped here.
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$(git rev-parse --show-toplevel)/scripts/preflight.ps1" -SkipEditorconfig "$@"
exit $?
