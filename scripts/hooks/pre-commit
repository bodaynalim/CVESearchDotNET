#!/bin/sh
# pre-commit hook (tickets T09 + T13): secret scanning on staged changes and
# editorconfig compliance on the whole solution.
# Fast (a few seconds), so committing secrets or unformatted code becomes
# impossible early; build and tests remain on the pre-push hook where a slower
# pipeline is acceptable.
node "$(git rev-parse --show-toplevel)/scripts/check-secrets.js" --staged || exit $?

powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "dotnet format --verify-no-changes --severity warn; exit \$LASTEXITCODE"
exit $?
