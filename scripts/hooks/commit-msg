#!/bin/sh
# commit-msg hook (tickets T09): commit message must reference a ticket number.
# Matches T01, T02, ... or a raw tracker issue number (#123 or bare 123) anywhere
# in the message (subject or body).
msg="$(cat "$1")"
if ! printf '%s' "$msg" | grep -Eqi '(^|[^A-Za-z0-9])(T[0-9]+|#[0-9]+)([^A-Za-z0-9]|$)'; then
  echo ""
  echo "commit-msg: REJECTED — commit message must reference a ticket (AGENTS.md §4)."
  echo "Example: 'T03: golden CVE mapping fixture'"
  exit 1
fi
